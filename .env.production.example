# ─────────────────────────────────────────────────────────────────────────────
# Production environment template (spec §13.2). Placeholders only; never commit real
# values. Set these in Coolify/Dokploy (runtime variables) and pass the same file to
# the image build as the `build_env` secret: catalog pages are prerendered from the
# database at build time. See docs/DEPLOYMENT.md.
# The server refuses to start if a value is missing or unsafe (lib/env/schema.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Public https origin; also the only trusted origin for authentication and forms.
APP_URL=https://store.example.com

# ── PostgreSQL 18 (independent managed service) ──────────────────────────────
# Same region as the VPS, reachable only from the VPS IP, TLS required (the server
# refuses to start without sslmode=require, verify-ca or verify-full). Use the
# provider's pooled endpoint if it offers one; keep this role without superuser rights.
DATABASE_URL=postgresql://store_app:change-me@db.example.com:5432/digital_products?sslmode=verify-full
DATABASE_POOL_MAX=10
# Optional: the direct (unpooled) endpoint, used only by migrations (prisma.config.ts),
# when DATABASE_URL points at a transaction-mode pooler.
# DIRECT_DATABASE_URL=postgresql://store_app:change-me@db-direct.example.com:5432/digital_products?sslmode=verify-full

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# 32+ random characters: openssl rand -base64 32. Rotating it signs everyone out.
BETTER_AUTH_SECRET=change-me-at-least-32-random-characters
# Behind Coolify/Dokploy's reverse proxy (Traefik), trust X-Forwarded-For only from it:
# its Docker network range, e.g. 10.0.1.0/24 (docker network inspect coolify).
AUTH_IP_HEADERS=x-forwarded-for
AUTH_TRUSTED_PROXIES=10.0.1.0/24

# ── Email (Resend, verified domain with SPF, DKIM and DMARC) ─────────────────
MAIL_FROM="Store Name <no-reply@store.example.com>"
RESEND_API_KEY=re_change_me

# ── Cloudflare Turnstile (customer sign-up), production widget for APP_URL ───
TURNSTILE_SITE_KEY=change-me-site-key
TURNSTILE_SECRET_KEY=change-me-secret-key

# ── Owner account (read only by `pnpm db:seed`; remove after seeding) ────────
# OWNER_USERNAME=owner
# OWNER_EMAIL=owner@store.example.com
# OWNER_PASSWORD=change-me-long-unique-passphrase
# OWNER_FIRST_NAME=Store
# OWNER_LAST_NAME=Owner

# ── Object storage (Cloudflare R2, S3 API) ───────────────────────────────────
# Account endpoint; the API token is limited to the two buckets (Object Read & Write).
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# Private: product files (never public). Public: product images and logos.
S3_BUCKET_PRIVATE=store-files
S3_BUCKET_PUBLIC=store-media
# The public bucket's custom domain. Baked into the build (image allowlist, CSP).
S3_PUBLIC_BASE_URL=https://media.store.example.com

# ── Payment gateways: LIVE keys only on the live store ───────────────────────
# A gateway is offered only when all of its variables are set AND it is enabled in
# /admin/settings. Webhook URLs: https://store.example.com/api/webhooks/{moyasar|paddle|paypal}
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=production
PADDLE_TAX_MODE=internal
PADDLE_TAX_CATEGORY=standard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=live

# Never set TEST_DOUBLES in production (the server refuses it off loopback anyway).
