# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and replace every "change-me" value:
#   cp .env.example .env.local
# Placeholders only — never commit real credentials. No secret may use NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── PostgreSQL 18 (Docker, 127.0.0.1:5462) ───────────────────────────────────
# Superuser password: used only by the container to bootstrap. The app never uses it.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
# Non-superuser role that owns only the project databases (created on first start).
APP_DB_USER=digital_app
APP_DB_PASSWORD=change-me-app-db-password
APP_DB_NAME=digital_products

DATABASE_URL=postgresql://digital_app:change-me-app-db-password@127.0.0.1:5462/digital_products
# Used by `prisma migrate dev` only.
SHADOW_DATABASE_URL=postgresql://digital_app:change-me-app-db-password@127.0.0.1:5462/digital_products_shadow
# Separate database for automated tests; it is reset before every run.
DATABASE_URL_TEST=postgresql://digital_app:change-me-app-db-password@127.0.0.1:5462/digital_products_test
# Optional: maximum connections in the pg pool (default 10).
DATABASE_POOL_MAX=10

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-random-characters
# Client IP for rate limits. Behind a reverse proxy that appends to X-Forwarded-For,
# list the proxy addresses/CIDRs in AUTH_TRUSTED_PROXIES (comma-separated).
AUTH_IP_HEADERS=x-forwarded-for
AUTH_TRUSTED_PROXIES=

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_FROM="Digital Store <no-reply@example.com>"
# Production: Resend API key (required). Leave empty locally to use Mailpit.
RESEND_API_KEY=
# Local capture: SMTP 127.0.0.1:1032, web UI and HTTP API http://127.0.0.1:8032.
MAILPIT_URL=http://127.0.0.1:8032

# ── Cloudflare Turnstile (customer sign-up) ──────────────────────────────────
# Cloudflare's documented test keys (always pass). Use real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Owner account (read only by `pnpm db:seed`) ──────────────────────────────
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-owner-password
OWNER_FIRST_NAME=Store
OWNER_LAST_NAME=Owner

# ── Object storage (MinIO locally, Cloudflare R2 in production) ──────────────
MINIO_ROOT_USER=change-me-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-password
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
# Application credentials limited to the two buckets below (created by minio-init).
S3_ACCESS_KEY_ID=change-me-app-access-key
S3_SECRET_ACCESS_KEY=change-me-app-secret-key
S3_BUCKET_PRIVATE=digital-products-files
S3_BUCKET_PUBLIC=digital-products-media
S3_PUBLIC_BASE_URL=http://127.0.0.1:9010/digital-products-media
