# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Only pnpm is used; stray lockfiles from other managers are never committed.
package-lock.json
yarn.lock
bun.lock
bun.lockb

# ── Next.js / build output ─────────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/

# ── Generated code ─────────────────────────────────────────
generated/

# ── Environment files (secrets) ────────────────────────────
# Every env file is ignored except the committed placeholder template.
.env
.env.*
!.env.example

# ── Testing ────────────────────────────────────────────────
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
tests/e2e/.auth/

# ── Docker volumes / local data ────────────────────────────
.docker-data/
docker/data/
*.dump
*.sql.gz

# ── Certificates & keys ────────────────────────────────────
*.pem
*.key
*.crt
*.p12

# ── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ── Bundle analyzer output ─────────────────────────────────
.next/analyze/
analyze/

# ── OS / editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
